  "about": {
    "eyebrow": "About",
    "heading": "A Voice For\nThe Late Set",
    "leadText": "Singing silky smooth, sweet, and sometimes a wee bit sticky.",
    "paragraphs": [
      "Based on Vancouver Island, Mel McCutcheon has become a fixture of the region's jazz rooms — a voice that moves easily between the warmth of a big band and the intimacy of a quartet.",
      "She currently fronts three different Vancouver Island ensembles, each built for a different room, a different band, the same unmistakable voice."
    ],
    "photo": "https://res.cloudinary.com/tpugvsad/image/upload/v1789514201/753170041_10175000342655201_6905816441516426856_n_wwtszl.jpg"
  },
  "sound": {
    "eyebrow": "Sound & Style",
    "heading": "Standards, Swing\n& A Little Smoke",
    "bodyText": "Timeless jazz standards, swinging favourites, Latin grooves and imaginative new arrangements — songs made famous by Sinatra, Bobby Darin and the golden age of jazz.",
    "influences": [
      "Sarah Vaughan",
      "Nina Simone"
    ],
    "quoteText": "\"Polished, relaxed and full of energy.\"",
    "quoteCite": "— City of Courtenay"
  },
  "ensembles": {
    "eyebrow": "Ensembles",
    "heading": "Three Bands.\nOne Voice.",
    "items": [
      {
        "name": "The Sharp Seven",
        "description": "Big-band jazz with Paul Nuez, Grahame Edwards, Michelle Draper, Jack Reynolds, Beau Stocker and Dave Lymburner. Built for a dance floor."
      },
      {
        "name": "Mel McCutcheon Quartet",
        "description": "A smaller combo for intimate rooms and private events — most recently the Hearts for Hospice benefit."
      },
      {
        "name": "Vintage Velvet",
        "description": "A quintet built around Mel's soulful, Vaughan- and Simone-inflected side. Late nights, low light."
      }
    ]
